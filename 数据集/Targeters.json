            },
            {
                "name": [
                    "minScale",
                    "mins"
                ],
                "type": "PlaceholderDouble",
                "description": "碰撞箱尺寸的最小缩放倍数",
                "default_value": "0"
            },
            {
                "name": [
                    "maxScale",
                    "maxs"
                ],
                "type": "PlaceholderDouble",
                "description": "碰撞箱尺寸的最大缩放倍数",
                "default_value": "1"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "RandomLocationsOfTargetsBoundingBoxTargeter",
        "extends": "ILocationSelector",
        "name": [
            "randomlocationsoftargetsboundingbox",
            "rlotbb",
            "rltbb"
        ],
        "description": "在所有目标实体的碰撞箱内生成随机位置",
        "attributes": [
            {
                "name": [
                    "amount",
                    "a"
                ],
                "type": "PlaceholderInteger",
                "description": "为每个目标生成的随机位置数量",
                "default_value": "5"
            },
            {
                "name": [
                    "minScale",
                    "mins"
                ],
                "type": "PlaceholderDouble",
                "description": "碰撞箱尺寸的最小缩放倍数",
                "default_value": "0"
            },
            {
                "name": [
                    "maxScale",
                    "maxs"
                ],
                "type": "PlaceholderDouble",
                "description": "碰撞箱尺寸的最大缩放倍数",
                "default_value": "1"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "SourceOwner",
        "extends": "IEntitySelector",
        "name": [
            "sourceowner",
            "so"
        ],
        "description": "获取施法者的所有者，或所有者的所有者，按指定深度遍历",
        "attributes": [
            {
                "name": [
                    "depth",
                    "d"
                ],
                "type": "PlaceholderInteger",
                "description": "遍历的所有权级别深度。如果未指定，将尽可能深地遍历直到找不到所有者为止",
                "default_value": "2147483647"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "TeamTargeter",
        "extends": "IEntitySelector",
        "name": [
            "team"
        ],
        "description": "获取特定计分板队伍中的所有实体",
        "attributes": [
            {
                "name": [
                    "team",
                    "t"
                ],
                "type": "String",
                "description": "计分板队伍的名称",
                "default_value": ""
            },
            {
                "name": [
                    "sameteam",
                    "sameTeam",
                    "st"
                ],
                "type": "Boolean",
                "description": "如果为 true，只获取与施法者在同一队伍中的实体",
                "default_value": "false"
            }
        ]
