[
    {
        "plugin": "MythicMobsAddon",
        "class": "HasMMOItemCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityCondition"
        ],
        "name": [
            "hasmmo",
            "hasmmoitem"
        ],
        "description": "检测目标实体的背包（包括盔甲栏、主副手及整个物品栏）中是否包含指定 ID 的 MMOItem。",
        "attributes": [
            {
                "name": [
                    "id"
                ],
                "type": "PlaceholderString",
                "description": "MMOItem 的物品 ID",
                "default_value": ""
            },
            {
                "name": [
                    "slot"
                ],
                "type": "PlaceholderInt",
                "description": "指定背包槽位检测；-1 表示检测全身装备与整个背包",
                "default_value": "-1"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "HasMMOItemCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityCondition"
        ],
        "name": [
            "inmmocombat"
        ],
        "description": "玩家是否处于战斗中。",
        "attributes": []
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "HoldingMMOItemCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityCondition"
        ],
        "name": [
            "holdingmmo",
            "holdingmmoitem"
        ],
        "description": "检测目标实体的【主手】是否正拿着指定 ID 的 MMOItem。",
        "attributes": [
            {
                "name": [
                    "id"
                ],
                "type": "PlaceholderString",
                "description": "MMOItem 的物品 ID",
                "default_value": ""
            },
            {
                "name": [
                    "offhand"
                ],
                "type": "PlaceholderBoolean",
                "description": "是否检测副手（false 为主手，true 为副手）",
                "default_value": "false"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "InputCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityCondition"
        ],
        "name": [
            "input"
        ],
        "description": "检测玩家当前的按键输入状态（如是否正在向前走、跳跃或潜行）。",
        "attributes": [
            { "name": ["forward"], "type": "Boolean", "description": "是否向前移动", "default_value": "false" },
            { "name": ["backward"], "type": "Boolean", "description": "是否向后移动", "default_value": "false" },
            { "name": ["left"], "type": "Boolean", "description": "是否向左移动", "default_value": "false" },
            { "name": ["right"], "type": "Boolean", "description": "是否向右移动", "default_value": "false" },
            { "name": ["jump"], "type": "Boolean", "description": "是否按下跳跃键", "default_value": "false" },
            { "name": ["sneak"], "type": "Boolean", "description": "是否正在潜行", "default_value": "false" },
            { "name": ["sprint"], "type": "Boolean", "description": "是否正在疾跑", "default_value": "false" }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "OriginDistanceCondition",
        "extends": "SkillCondition",
        "implements": [
            "ISkillMetaComparisonCondition"
        ],
        "name": [
            "origindistance"
        ],
        "description": "检测目标实体与技能触发原点（Origin）之间的距离。支持范围判断。",
        "attributes": [
            {
                "name": [ "distance", "d" ],
                "type": "PlaceholderString",
                "description": "距离范围要求（如 <10 或 5..15）",
                "default_value": ""
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "PoseCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityCondition"
        ],
        "name": [
            "pose"
        ],
        "description": "检测实体的姿势（如站立、潜行、游泳、滑翔等）。",
        "attributes": [
            {
                "name": [ "pose", "p" ],
                "type": "Enum",
                "description": "姿势名称：STANDING, FALL_FLYING, SLEEPING, SWIMMING, SPIN_ATTACK, SNEAKING, LONG_JUMPING, DYING, CROUCHING, ROARING, SNIFFING, EMERGING, DIGGING",
                "default_value": "STANDING"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "SameTeamCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityComparisonCondition",
            "ISkillMetaComparisonCondition"
        ],
        "name": [
            "sameteam"
        ],
        "description": "检测施法者与目标实体是否在同一个原版计分板（Scoreboard）队伍中。",
        "attributes": []
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "SimpleBlockTypeCondition",
