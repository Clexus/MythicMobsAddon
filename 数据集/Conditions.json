        "implements": [
            "ILocationCondition"
        ],
        "name": [
            "simpleblocktype"
        ],
        "description": "检测指定偏移位置下的方块类型是否匹配。",
        "attributes": [
            {
                "name": [ "types", "type", "t", "material", "mat", "m", "block", "b" ],
                "type": "String",
                "description": "方块材质名称（如 DIRT, STONE）",
                "default_value": "DIRT"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "SitCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityCondition"
        ],
        "name": [
            "sit",
            "sitting"
        ],
        "description": "检测可坐下的实体（如狼、猫等）当前是否处于坐下状态。",
        "attributes": [
            {
                "name": [ "sitting", "sit", "s" ],
                "type": "Boolean",
                "description": "是否处于坐下状态",
                "default_value": "true"
            }
        ]
    },
    {
        "plugin": "MythicMobsAddon",
        "class": "TeamCondition",
        "extends": "SkillCondition",
        "implements": [
            "IEntityCondition"
        ],
        "name": [
            "team"
        ],
        "description": "检测实体是否属于指定的计分板队伍。",
        "attributes": [
            {
                "name": [ "team", "t" ],
